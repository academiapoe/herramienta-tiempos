{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiempos-equipo",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tiempos-equipo"
    }
  ],
  "vars": {
    "ZONA_HORARIA": "Europe/Madrid"
  }
}
